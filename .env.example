# 复制为 .env 后填写；本文件不包含可用的密码或密钥。
# 既有部署必须保留原密钥与数据目录，不能用模板覆盖真实配置。

# 镜像自动适配 Linux AMD64 / ARM64。
# 请求模式在后台“代理 → HTTP 传输”选择，推荐并默认使用 wreq。
ALL_IN_ONE_IMAGE=lisa666520/claude-mirror:latest
PORT=41002
BIND_ADDRESS=127.0.0.1
DATA_DIR=./data

# 首次部署的管理员账号；密码必须填写。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 三项独立密钥，分别使用 openssl rand -hex 32 生成并填写。
GATEWAY_ADMIN_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
DJANGO_SECRET_KEY=

# 将示例域名替换为实际 HTTPS 域名。
DJANGO_ALLOWED_HOSTS=你的域名,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://你的域名

# HTTPS 部署保持以下三个值为 true。
COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# 默认由管理员创建用户，站点登录凭据有效期以秒计。
ALLOW_REGISTER=false
API_TOKEN_TTL_SECONDS=604800

# 可选，仅填写实际反向代理的可信来源 IP，多个 IP 以逗号分隔。
TRUSTED_PROXY_IPS=
TZ=America/Los_Angeles
