# 公开前端、管理后端与部署资料，其余根目录内容默认不提交。
/*

!/README.md
!/LICENSE
!/.gitignore
!/.env.example
!/docker-compose.yml
!/frontend/
!/backend/

# 依赖、构建产物与测试输出。
node_modules/
.venv/
venv/
dist/
build/
coverage/
htmlcov/
.coverage
.coverage.*

# Python、前端工具与类型检查缓存。
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
.vite/
.vite-temp/
.eslintcache
.stylelintcache
*.tsbuildinfo

# 运行数据、日志、真实环境配置与抓包文件。
/backend/db/
/backend/logs/
/backend/media/
*.log
*.log.*
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.har
.env
.env.*
!/.env.example

# 系统与编辑器临时文件。
.DS_Store
._*
Thumbs.db
*.swp
*.swo
*~
